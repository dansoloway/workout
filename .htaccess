Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /workout/

    # Keep application files off the web. Only public/ is served.
    RewriteRule ^(?:\.|app(?:/|$)|bootstrap(?:/|$)|config(?:/|$)|database(?:/|$)|resources(?:/|$)|routes(?:/|$)|storage(?:/|$)|tests(?:/|$)|vendor(?:/|$)|node_modules(?:/|$)|artisan$|composer\.(?:json|lock)$|package(?:-lock)?\.json$|phpunit\.xml$|vite\.config\.js$) - [F,L]

    RewriteCond %{DOCUMENT_ROOT}/workout/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [END]

    RewriteRule ^ public/index.php [END]
</IfModule>
